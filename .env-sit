# ============================================================
#  Finance Research Agent — environment configuration
#  Copy to `.env` and fill in your values:  cp .env.example .env
# ============================================================

# ---- LLM (required) ----
OPENAI_API_KEY=""
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ---- Web search ----
# Provider: "auto" picks tavily if TAVILY_API_KEY is set, else duckduckgo.
# Force one with "tavily" or "duckduckgo".
SEARCH_PROVIDER=auto
TAVILY_API_KEY=""
SEARCH_MAX_RESULTS=5

# ---- Conversation memory (SQLite for demo) ----
DATABASE_URL=sqlite:///./data/conversations.db

# ---- API server ----
APP_NAME=financial-research-agent
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Optional: simple API key gate for the REST layer ----
# Leave empty to disable auth (demo). Set to require `X-API-Key` header.
API_AUTH_KEY=
